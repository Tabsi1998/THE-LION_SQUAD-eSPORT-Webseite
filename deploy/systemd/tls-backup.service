[Unit]
Description=THE LION SQUAD encrypted backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/the-lion-squad
ExecStart=/usr/bin/bash scripts/backup.sh
User=root
UMask=0077
Nice=10
# Obergrenze für den ganzen Lauf (#1009): hängt etwas, beendet systemd das Skript. Die Schreibpause endet trotzdem -
# die Lease läuft ohne Verlängerung ab, ihr Verlängern hört spätestens nach BACKUP_WRITE_PAUSE_MAX_SECONDS auf.
TimeoutStartSec=2h
