      "./plugins/withReleaseManifest.js",
      "./plugins/withReleaseOptimization.js",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Die LionsAPP liest am Eingang der Generalversammlung den QR-Code der Mitgliedskarte.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Die LionsAPP entsperrt sich mit Face ID, wenn du die App-Sperre einschaltest."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#29B6E8"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "LionsAPP greift auf deine Fotos und Videos zu, damit du sie im Chat senden kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Die LionsAPP trägt Termine in deinen Kalender ein, wenn du es antippst.",
          "remindersPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-sensors",
        {
          "motionPermission": "Die LionsAPP lässt Deko der Jahreszeiten beim Neigen des Handys mitschwingen."
        }
      ]
    ],
