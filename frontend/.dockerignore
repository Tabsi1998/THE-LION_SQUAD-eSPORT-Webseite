# Build-Kontext des Frontend-Images (docker-compose.yml: context: ./frontend).
# Das Image installiert die Pakete selbst (yarn install --frozen-lockfile); ein lokales
# node_modules darf sie nicht überschreiben. Bleibt im Kontext: package.json, yarn.lock,
# src, public, index.html, vite.config.mjs, tailwind.config.js, postcss.config.js,
# jsconfig.json, nginx.conf.
# Braucht der Build oder das Image eine Datei, die hier steht, den Eintrag entfernen
# (siehe docs/BETRIEB.md, Abschnitt "Docker-Build-Kontext").

# Pakete, Build- und Testausgaben
node_modules
dist
build
coverage
playwright-report
test-results

# Ende-zu-Ende-Tests und Hilfsskripte (nicht Teil des Builds)
e2e
scripts

# Konfiguration und Protokolle
.env
.env.*
*.env
*.log

# Docker-Dateien selbst
Dockerfile
.dockerignore
