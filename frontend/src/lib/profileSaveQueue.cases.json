{
  "_hinweis": "Speicher-Warteschlange für Profil und Einstellungen (#1048, #1061): dieselben Fälle prüfen frontend/src/lib/profileSaveQueue.test.js und mobile/src/lib/profileSaveQueue.test.ts. Schritte: edit (lokale Änderung), flush (Speichern; mit Namen wird das Ergebnis gemerkt), respond/fail (Antwort auf Anfrage Nr. i), load (Serverstand von außen, etwa nach dem Neuladen der Sitzung; null = abgemeldet), stamp/merge (Teilstand vom Server mit Stempel), expect (Prüfung). Serverdaten tragen id (Konto) und updated_at (Revision). Namen sind erfunden.",
  "scenarios": [
    {
      "name": "Änderungen während eines laufenden Speicherns gehen gesammelt mit dem nächsten Lauf",
      "server": { "id": "u1", "updated_at": "2026-10-13T10:00:00+00:00", "a": 0, "b": 0, "c": 0 },
      "steps": [
        { "edit": { "a": 1 } },
        { "flush": "erster" },
        { "expect": { "status": "saving", "open": 1, "requests": [{ "account": "u1", "payload": { "a": 1 } }] } },
        { "edit": { "b": 1 } },
        { "flush": null },
        { "edit": { "c": 1 } },
        { "flush": null },
        { "expect": { "open": 1, "local": { "a": 1, "b": 1, "c": 1 } } },
        { "respond": 0, "server": { "id": "u1", "updated_at": "2026-10-13T10:00:01+00:00", "a": 1, "b": 0, "c": 0 } },
        { "expect": { "status": "saving", "open": 1, "local": { "a": 1, "b": 1, "c": 1 }, "results": { "erster": { "ok": true } }, "requests": [{ "account": "u1", "payload": { "a": 1 } }, { "account": "u1", "payload": { "b": 1, "c": 1 } }] } },
        { "respond": 1, "server": { "id": "u1", "updated_at": "2026-10-13T10:00:02+00:00", "a": 1, "b": 1, "c": 1 } },
        { "expect": { "status": "saved", "dirty": false, "open": 0, "local": { "a": 1, "b": 1, "c": 1 } } }
      ]
    },
    {
      "name": "eine Antwort überschreibt keine neuere Eingabe",
