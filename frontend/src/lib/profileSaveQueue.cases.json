        { "respond": 0, "server": { "id": "u1", "updated_at": "2026-10-13T10:00:01+00:00", "a": 1, "b": 0 } },
        { "expect": { "account": "u2", "local": { "a": 5, "b": 5 }, "dirty": false, "status": "idle", "open": 0 } },
        { "flush": "danach" },
        { "expect": { "results": { "danach": { "ok": true, "nothing": true } }, "requests": [{ "account": "u1", "payload": { "a": 1 } }] } }
      ]
    },
    {
