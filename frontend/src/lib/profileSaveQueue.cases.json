      "steps": [
        { "edit": { "name": "A" } },
        { "flush": null },
        { "edit": { "name": "AB" } },
        { "respond": 0, "server": { "id": "u1", "updated_at": "2026-10-13T10:00:01+00:00", "name": "A" } },
        { "expect": { "local": { "name": "AB" }, "dirty": true, "status": "idle", "open": 0 } }
      ]
    },
    {
