# Lokaler Abnahme-Stand (docs/entwicklung/abnahme-lokal.md) - nur Testwerte, nichts davon erreicht ein echtes System.
# Nicht für Produktion oder Staging verwenden.
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:23000
PUBLIC_BACKEND_URL=http://127.0.0.1:23000
CORS_ORIGINS=http://127.0.0.1:23000
TRUSTED_HOSTS=127.0.0.1,localhost
MONGO_USERNAME=lsw_abnahme
MONGO_PASSWORD=abnahme-nur-lokal
DB_NAME=tls_abnahme
JWT_SECRET=abnahme-nur-lokal-jwt-mit-mindestens-32-zeichen
SETTINGS_ENCRYPTION_KEY=NQBHeGtQg5HYMo1HzvJtSQPN7X8YpJrZDvw-XMz0Bm8=
# Nur ausgewählte Jobs (#1609) - den Rest (Mails, Erinnerungen, Discord) stößt der Seed selbst an.
DISABLE_SCHEDULER=false
SCHEDULER_JOBS=result_holds,draw_show
# Kein Push, keine Discord-DM, kein Discord-Bot nach außen.
OUTBOUND_DISABLED=true
CLIENT_LOGGING_ENABLED=true
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=28001
FRONTEND_PORT=23000
