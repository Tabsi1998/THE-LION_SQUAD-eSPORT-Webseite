{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ab43bcee6044dccb836282dc7e4518d164c44a3e",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: Website ${version} veröffentlichen",
  "pull-request-header": "Release-PR der Website. Mergen erzeugt Tag, GitHub-Release und den Eintrag in CHANGELOG.md. Den Server spielst du danach wie gewohnt mit `./update.sh u` ein.",
  "changelog-sections": [
    { "type": "feat", "section": "Neu" },
    { "type": "fix", "section": "Fehlerbehebungen" },
    { "type": "perf", "section": "Schneller" },
    { "type": "revert", "section": "Zurückgenommen" },
    { "type": "docs", "section": "Dokumentation" },
    { "type": "deps", "section": "Abhängigkeiten" },
    { "type": "refactor", "section": "Umbau", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "style", "section": "Stil", "hidden": true },
    { "type": "chore", "section": "Pflege", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "lionsquad-website",
      "initial-version": "1.0.0",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["mobile", "docs/handbuch/app.md"],
      "extra-files": [
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
